# API Configuration
VITE_API_URL=
VITE_SOCKET_URL=
# Optional fallback if backend /auth/security-config is unavailable.
# Prefer setting TURNSTILE_SITE_KEY on backend instead.
VITE_TURNSTILE_SITE_KEY=

# BlockCypher (UTXO testnets)
BLOCKCYPHER_TOKEN=

# BTC/LTC/ETH network modes
BTC_NETWORK_MODE=
LTC_NETWORK_MODE=
ETH_NETWORK_MODE=

# ETH USD conversion overrides (tickets/payout math)
# Mainnet default fallback: 3000
# Sepolia testnet default fallback: 55555.55555556 (so 0.009 ETH ~= $500)
ETH_MAINNET_USD_RATE=
ETH_TESTNET_USD_RATE=

# BTC/LTC/ETH wallets (per network)
BTC_TESTNET_WALLET=
BTC_MAINNET_WALLET=
LTC_TESTNET_WALLET=
LTC_MAINNET_WALLET=
ETH_TESTNET_WALLET=
ETH_MAINNET_WALLET=

# Frontend explorer network modes
VITE_BTC_NETWORK_MODE=
VITE_LTC_NETWORK_MODE=
