# Server Configuration
PORT=
NODE_ENV=

# MongoDB Configuration
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/handshake_db?retryWrites=true&w=majority
MONGODB_URI=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRE=

# Frontend URL(s) (for CORS)
# Use comma-separated origins when running multiple dev servers.
CLIENT_URL=
# CLIENT_URLS=

# Email Delivery Configuration
# Recommended on Render: use HTTP API provider (e.g., Resend) instead of SMTP.
# Supported providers: resend, smtp
EMAIL_PROVIDER=
EMAIL_FROM=

# Resend API (recommended)
RESEND_API_KEY=

# Cloudflare Turnstile (signup captcha)
# In production, set BOTH site + secret keys from your Turnstile widget.
# TURNSTILE_ENABLED is optional:
# - true: force enabled (fails closed if keys are missing)
# - false: force disabled
# - unset: auto-enable when a secret key exists
TURNSTILE_ENABLED=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Development fallback when both keys above are blank (handled in code):
# site key:   1x00000000000000000000AA
# secret key: 1x0000000000000000000000000000000AA

# SMTP fallback (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# BlockCypher API Configuration (for Bitcoin/Litecoin testnets)
BLOCKCYPHER_TOKEN=

# ============================================
# HD WALLET DEPOSIT DERIVATION (per-ticket address generation)
# ============================================
# Each ticket / pass order gets its own unique deposit address derived from
# the chain's xpub at a unique index. This is what guarantees two tickets
# can never collide on the same address (the multi-ticket same-amount bug).
#
# In external signer mode, the public API holds no xpubs or mnemonics. It asks
# the private signer to derive each public deposit address. The variables below
# must be set only in the signer service environment, never in the public API.
#
# Generate xpubs in Sparrow Wallet (testnet mode, Native SegWit P2WPKH).
# Generate ETH/SOL mnemonics with: node -e "import('bip39').then(({generateMnemonic}) => console.log(generateMnemonic()))"

# Bitcoin
# Production requires HD_BTC_NETWORK=mainnet and BTC_NETWORK_MODE=mainnet.
HD_BTC_XPUB=
# Signer process only, required for automatic BTC payout/refund.
HD_BTC_MNEMONIC=
HD_BTC_NETWORK=

# Litecoin
# Production requires HD_LTC_NETWORK=mainnet and LTC_NETWORK_MODE=mainnet.
HD_LTC_XPUB=
# Signer process only, required for automatic LTC payout/refund.
HD_LTC_MNEMONIC=
HD_LTC_NETWORK=

# Ethereum (+ USDT-ERC20, USDC-ERC20 — same chain, same address)
# Production requires HD_ETH_NETWORK=mainnet and ETH_NETWORK_MODE=mainnet.
HD_ETH_MNEMONIC=
HD_ETH_XPUB=
HD_ETH_NETWORK=

# Solana (+ USDT-SPL, USDC-SPL — same chain, same address)
# Production requires HD_SOL_NETWORK=mainnet.
HD_SOL_MNEMONIC=
HD_SOL_NETWORK=

# ============================================
# WALLET SIGNER ISOLATION
# ============================================
# Production should run `npm run start:signer` as a private service and set the
# public API to WALLET_SIGNER_MODE=external. The public app sends transfer
# requests to SIGNER_SERVICE_URL; only the signer process should have signing
# mnemonics or future UTXO signing keys.
# When NODE_ENV=production, startup fails unless enabled ticket currencies are
# explicitly mainnet and signer/gas settings are complete.
WALLET_SIGNER_MODE=external
SIGNER_SERVICE_URL=http://127.0.0.1:5055
SIGNER_SERVICE_TOKEN=
ENABLED_TICKET_CURRENCIES=
SIGNER_PORT=5055
SIGNER_ENABLED_CHAINS=bitcoin,litecoin,ethereum,solana
ALLOW_APP_PROCESS_SIGNING=false
ALLOW_TOKEN_DEPOSIT_ADDRESS_PAYOUTS=false
AUTO_FUND_DEPOSIT_GAS=false
TREASURY_ETH_PRIVATE_KEY=
TREASURY_SOL_PRIVATE_KEY=
ETH_GAS_BUFFER_ETH=0.00015
ETH_FALLBACK_GAS_PRICE_GWEI=20
SOL_GAS_BUFFER_LAMPORTS=10000000
MIN_SPL_GAS_LAMPORTS=10000000
MAX_TICKET_PAYOUT_USD=2500
MAX_TICKET_REFUND_USD=2500
MAX_PASS_REFUND_USD=500
SIGNER_MAX_TICKET_PAYOUT_USD=2500
SIGNER_MAX_TICKET_REFUND_USD=2500
SIGNER_MAX_PASS_REFUND_USD=500
WALLET_TRANSFER_CONFIRMATION_CRON=*/30 * * * * *
WALLET_TRANSFER_MONITOR_BATCH_SIZE=50

# ============================================
# LAUNCH CUSTODY/RISK LIMITS
# ============================================
MAX_TRADE_USD=2500
ENHANCED_AUTH_TRADE_USD=500
MAX_USER_COMMITTED_EXPOSURE_USD=5000
MAX_PLATFORM_COMMITTED_EXPOSURE_USD=25000

# ============================================
# AI TRANSACTION SAFETY COPILOT
# ============================================
# The safety workflow is always backed by deterministic rules. Set AI safety
# enabled only when both an API key and an explicitly selected model are set.
# AI has no wallet/signer credentials and can never release or refund funds.
AI_SAFETY_REVIEW_REQUIRED=true
AI_SAFETY_ENABLED=false
OPENAI_API_KEY=
OPENAI_SAFETY_MODEL=
AI_SAFETY_TIMEOUT_MS=15000

# ============================================
# BITCOIN CONFIGURATION
# ============================================
BTC_NETWORK_MODE=
BTC_TESTNET_WALLET=
BTC_MAINNET_WALLET=

# ============================================
# LITECOIN CONFIGURATION
# ============================================
LTC_NETWORK_MODE=
LTC_TESTNET_WALLET=
LTC_MAINNET_WALLET=
LTC_TESTNET_PRIVATE_KEY=

# ============================================
# ETHEREUM CONFIGURATION
# ============================================

# Network Mode: 'testnet' for Sepolia, 'mainnet' for production
ETH_NETWORK_MODE=

# Sepolia Testnet Configuration (for testing)
ETH_TESTNET_WALLET=
SEPOLIA_RPC_URL=

# Ethereum Mainnet Configuration (for production)
ETH_MAINNET_WALLET=
ETH_MAINNET_RPC_URL=

# Alternative RPC Providers:
# Alchemy Sepolia: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Alchemy Mainnet: https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Public Sepolia (rate limited): https://rpc.sepolia.org

# ============================================
# DISCORD PROFILE SYNC
# ============================================

# Bot token used to fetch Discord user profile data
DISCORD_BOT_TOKEN=

# Discord user ID to fetch for profile sync
DISCORD_USER_ID=

# Daily refresh schedule (cron) + timezone
DISCORD_PROFILE_REFRESH_CRON=
DISCORD_PROFILE_REFRESH_TZ=

# Discord OAuth (required for "Connect Discord" in Settings)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional override; defaults to DISCORD_CLIENT_ID
DISCORD_APPLICATION_ID=
# Required to verify Discord interaction signatures (/sync command endpoint)
DISCORD_APPLICATION_PUBLIC_KEY=
DISCORD_OAUTH_REDIRECT_URI=
DISCORD_SETTINGS_REDIRECT_URL=
DISCORD_GUILD_ID=
DISCORD_OAUTH_SCOPES=
DISCORD_SYNC_LOG_CHANNEL_ID=
# Completed ticket embed channel
DISCORD_COMPLETED_TICKET_CHANNEL_ID=

# Rank -> Discord Role mapping
DISCORD_ROLE_ID_RANK_MANAGER=
DISCORD_ROLE_ID_RANK_OWNER=
DISCORD_ROLE_ID_RANK_RUBY_RICH=
DISCORD_ROLE_ID_RANK_TOP_CLIENT=
DISCORD_ROLE_ID_RANK_RICH_CLIENT=
DISCORD_ROLE_ID_RANK_CLIENT=
DISCORD_ROLE_ID_RANK_DEVELOPER=
# Optional if you use rank "admin"
DISCORD_ROLE_ID_RANK_ADMIN=

# Legacy role mapping fallback (optional)
DISCORD_ROLE_ID_USER=
DISCORD_ROLE_ID_MODERATOR=
DISCORD_ROLE_ID_ADMIN=
